{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eh-webhook",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // Non-secret, per-deployment. Fill these from the client's accounts (see docs/RUNBOOK.md).
  // Secrets are set with `wrangler secret put`: CT_API_KEY, EH_API_KEY, CT_WEBHOOK_SECRET,
  // and optionally STATUS_TOKEN (see below).
  "vars": {
    // Leave blank: the Worker loads clients/self/field-map.json. Set only for a
    // multi-tenant deployment (see src/mapping/registry.ts).
    "FIELD_MAP_CLIENT": "",
    "EH_BUSINESS_ID": "",
    "CT_ONBOARDING_PACK_ID": "",
    "CT_CUSTOM_PUBLISHER_ID": "",
    "ADMIN_CONNECTEAM_CHANNEL_ID": "",
    // Day of week (0=Sun..6=Sat, UTC) the weekly /status digest posts to the
    // admin channel. Blank = Monday. It can also always be run on demand via
    // `POST /status/digest`.
    "STATUS_DIGEST_DAY": "",
    // Optional integrator telemetry -> the standalone integrator-relay/ Worker.
    // Blank URL = off. INTEGRATOR_ALERT_SECRET is a secret (`wrangler secret
    // put`), not a var, and must equal the relay's RELAY_SECRET.
    "INTEGRATOR_ALERT_URL": "",
    // Short slug for this client on the shared relay (e.g. "acme").
    "INTEGRATOR_CLIENT_ID": ""
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "eh-webhook",
      "database_id": "2da451a0-fb39-477c-b076-69078b174924",
      "migrations_dir": "migrations"
    }
  ],

  "queues": {
    "producers": [{ "binding": "SYNC_QUEUE", "queue": "eh-webhook-sync" }],
    "consumers": [
      {
        "queue": "eh-webhook-sync",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "eh-webhook-dlq"
      },
      {
        // Retry-exhausted jobs land here; the consumer posts a System alert and acks.
        "queue": "eh-webhook-dlq",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3
      }
    ]
  },

  "triggers": { "crons": ["* * * * *"] }
}
