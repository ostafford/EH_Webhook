{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eh-webhook-integrator-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "observability": { "enabled": true },

  // Non-secret config. Secrets are set with `wrangler secret put`:
  //   RELAY_SECRET   - the shared x-eh-sync-secret; each client's
  //                    INTEGRATOR_ALERT_SECRET must equal this.
  //   GITHUB_TOKEN   - a fine-grained PAT with Issues: Read and write on the
  //                    repo below (nothing else). Lives ONLY here.
  "vars": {
    // owner/name of the repo that receives the alert issues.
    "GITHUB_REPO": "ostafford/EH_Webhook",
    // Optional: also POST a compact alert to this URL (Zapier / Make / an SMTP
    // bridge) for instant email. Blank = GitHub-issue notifications only.
    "EMAIL_WEBHOOK_URL": ""
  }
}
